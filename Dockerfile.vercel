FROM ubuntu:24.04 AS build

ARG GODOT_VERSION=4.7.2
ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

RUN curl -fL --retry 3 \
    "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}-stable/Godot_v${GODOT_VERSION}-stable_linux.x86_64.zip" \
    -o /tmp/godot.zip \
 && unzip -q /tmp/godot.zip -d /opt/godot \
 && chmod +x /opt/godot/Godot_v${GODOT_VERSION}-stable_linux.x86_64 \
 && ln -s /opt/godot/Godot_v${GODOT_VERSION}-stable_linux.x86_64 /usr/local/bin/godot

RUN mkdir -p /root/.local/share/godot/export_templates/${GODOT_VERSION}.stable \
 && curl -fL --retry 3 \
    "https://github.com/godotengine/godot/releases/download/${GODOT_VERSION}-stable/Godot_v${GODOT_VERSION}-stable_export_templates.tpz" \
    -o /tmp/templates.tpz \
 && unzip -q /tmp/templates.tpz -d /tmp/templates \
 && cp -a /tmp/templates/templates/. /root/.local/share/godot/export_templates/${GODOT_VERSION}.stable/

RUN mkdir -p build/web \
 && godot --headless --editor --path /src --quit-after 2 \
 && godot --headless --path /src --export-release "Web" build/web/index.html \
 && test -f build/web/index.html \
 && test -f build/web/index.wasm

FROM python:3.13-slim
WORKDIR /app
COPY --from=build /src/build/web /app/web
ENV PORT=80
CMD ["sh","-c","python3 -m http.server \"$PORT\" --bind 0.0.0.0 --directory /app/web"]
